<mxfile host="app.diagrams.net"><diagram id="termpocket-architecture" name="Architecture"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;TermPocket architecture&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Repo, Render service and Neon DB are still named MindGo · 2026-10&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1640" height="46" as="geometry"/></mxCell><mxCell id="n2" value="User's browser" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;fillColor=#F2F7FD;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="400" height="560" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Next.js 15 frontend&lt;/b&gt; (Pages Router, React 18, TS)&lt;br&gt;Vercel project &lt;i&gt;termpocket&lt;/i&gt;, deploys &lt;i&gt;main&lt;/i&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Dashboard · Transactions · Goals · Import · Pocky (/agent)&lt;br&gt;Settings (AI connections, retention, delete account) · Privacy/Terms&lt;br&gt;i18n en / zh · axios client + JWT in localStorage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="n2"><mxGeometry x="20" y="40" width="360" height="120" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;On-device OCR&lt;/b&gt;&lt;br&gt;ONNX Runtime WASM (/ort) + OCR model (/models)&lt;br&gt;&lt;font style='font-size:10px'&gt;Screenshots never leave the device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="n2"><mxGeometry x="20" y="190" width="360" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;On-device dictation&lt;/b&gt;&lt;br&gt;Whisper base.en in a Web Worker (/voice)&lt;br&gt;&lt;font style='font-size:10px'&gt;Audio never leaves the device; text goes to the composer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="n2"><mxGeometry x="20" y="280" width="360" height="70" as="geometry"/></mxCell><mxCell id="n6" value="Only text leaves the browser: OCR lines go to /import/parse, transcripts are sent like typed messages. No server session; a 401 logs out." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#D6B656;" vertex="1" parent="n2"><mxGeometry x="20" y="380" width="360" height="60" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Personal AI agent&lt;/b&gt;&lt;br&gt;(MCP client, e.g. Claude)&lt;br&gt;&lt;font style='font-size:10px'&gt;Authenticates with an mgo_ access token, never the login JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="400" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;User's inbox&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Verification links · weekly report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="400" height="56" as="geometry"/></mxCell><mxCell id="n9" value="termpocket-api — Express + TypeScript (Render, Virginia; compiled to dist/)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;arcSize=4;fillColor=#FFE6CC;strokeColor=#D79B00;fillColor=#FFF8EE;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="640" height="860" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Middleware&lt;/b&gt;: helmet · morgan (redactUrl) · CORS · JSON limits · rate limiters · JWT auth (req.user.userId) · express-validator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="n9"><mxGeometry x="20" y="36" width="600" height="44" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Routers&lt;/b&gt;&lt;br&gt;/auth · /transactions · /summary · /goals · /import · /access-tokens · /agent&lt;br&gt;&lt;font style='font-size:10px'&gt;route → validation → controller → service / db&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="n9"><mxGeometry x="20" y="96" width="400" height="64" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;/mcp&lt;/b&gt; JSON-RPC&lt;br&gt;&lt;font style='font-size:10px'&gt;read-only totals (moneyFacts)&lt;br&gt;per-user + per-IP limits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="n9"><mxGeometry x="440" y="96" width="180" height="64" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;accountService (delete account) · termsService · accessTokens (SHA-256, 90-day expiry)&lt;br&gt;exchangeRateService (read-time conversion, 6 currencies) · emailService · emailValidationService&lt;br&gt;moneyFacts (SQL aggregates) · import parser: classify → bank-list / receipt / uber / uber-eats / wechat-pay&lt;br&gt;utils: terms.ts (Waterloo terms) · dates.ts · errorSummary · privacy (maskEmail)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="n9"><mxGeometry x="20" y="180" width="600" height="104" as="geometry"/></mxCell><mxCell id="n14" value="Pocky — conversation recording (services/agent)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;arcSize=4;fillColor=#F8CECC;strokeColor=#B85450;fillColor=#FDF3F2;" vertex="1" parent="n9"><mxGeometry x="20" y="304" width="600" height="250" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;runtime.ts&lt;/b&gt;&lt;br&gt;@anthropic-ai/sdk tool loop&lt;br&gt;&lt;font style='font-size:10px'&gt;budgets: 8 tool calls, 64k tokens, 90 s&lt;br&gt;thinking off · prompt caching · no DB access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="n14"><mxGeometry x="16" y="34" width="270" height="84" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Tools&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;propose_transactions · spending_summary&lt;br&gt;compare_spending · transaction_details&lt;br&gt;spending_baseline · list_goals · calculate_scenario&lt;br&gt;propose_goal · propose_memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="n14"><mxGeometry x="306" y="34" width="278" height="84" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;store.ts&lt;/b&gt; — short DB transactions, owner locks, run admission, draft revisions, confirm / undo, goal &amp;amp; memory proposals&lt;br&gt;&lt;font style='font-size:10px'&gt;Only button-confirmed endpoints write transactions, goals or memories · demo account refused for clears&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="n14"><mxGeometry x="16" y="136" width="568" height="60" as="geometry"/></mxCell><mxCell id="n18" value="Admission: 1 live run / user · 20 per hour · 60 per day · 600 per day all users · 4 concurrent per process" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="n14"><mxGeometry x="16" y="208" width="568" height="30" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;schedulerService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Weekly report: node-cron, Sun 7 p.m. America/Toronto (production only)&lt;br&gt;Hourly maintenance: stale unverified accounts · opt-in transaction retention (whole terms) · agent housekeeping · demo refresh when stale&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="n9"><mxGeometry x="20" y="574" width="600" height="76" as="geometry"/></mxCell><mxCell id="n20" value="Errors on import / MCP / token / agent paths are logged only as { userId, error, code }. Never logged: credentials, OCR text, row values, fact text." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#D6B656;" vertex="1" parent="n9"><mxGeometry x="20" y="670" width="600" height="44" as="geometry"/></mxCell><mxCell id="n21" value="Neon suspends after ~5 idle minutes: no DB in /health, no short-interval jobs." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#D6B656;" vertex="1" parent="n9"><mxGeometry x="20" y="726" width="600" height="30" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Neon PostgreSQL&lt;/b&gt; (15+)&lt;br&gt;AWS us-east-1 · pooled endpoint&lt;br&gt;&lt;font style='font-size:10px'&gt;users · transactions · savings_goals · import_batches · access_tokens&lt;br&gt;agent_conversations · agent_messages · agent_runs · agent_drafts&lt;br&gt;agent_receipts · agent_admissions · agent_goal_proposals&lt;br&gt;agent_memories · agent_memory_proposals · schema_migrations&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="440" height="170" as="geometry"/></mxCell><mxCell id="n23" value="External services" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fillColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="1240" y="290" width="440" height="400" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Anthropic&lt;/b&gt; (Claude API)&lt;br&gt;&lt;font style='font-size:10px'&gt;model claude-sonnet-5-5 · messages, matching records, memories&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="n23"><mxGeometry x="20" y="36" width="400" height="60" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Frankfurter&lt;/b&gt; exchange rates&lt;br&gt;&lt;font style='font-size:10px'&gt;5 s timeout; a bad rate is an error, never a guess&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="n23"><mxGeometry x="20" y="116" width="400" height="56" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;MailboxLayer&lt;/b&gt; address check at sign-up&lt;br&gt;&lt;font style='font-size:10px'&gt;falls back to a disposable-domain list; never blocks on failure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="n23"><mxGeometry x="20" y="192" width="400" height="56" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;SMTP&lt;/b&gt; (Resend in production; Gmail by default)&lt;br&gt;&lt;font style='font-size:10px'&gt;verification email · weekly report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="n23"><mxGeometry x="20" y="268" width="400" height="56" as="geometry"/></mxCell><mxCell id="n28" value="Delivery" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;fillColor=#F4FAF3;" vertex="1" parent="1"><mxGeometry x="1240" y="730" width="440" height="210" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;GitHub&lt;/b&gt; repo (backend/, frontend/, eval/)&lt;br&gt;&lt;font style='font-size:10px'&gt;Actions CI: backend lint + tests on Postgres · frontend locales, lint, build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="n28"><mxGeometry x="20" y="36" width="400" height="56" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;frontend/, main only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="n28"><mxGeometry x="20" y="112" width="190" height="52" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Render&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;backend/, npm ci + build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="n28"><mxGeometry x="230" y="112" width="190" height="52" as="geometry"/></mxCell><mxCell id="n32" value="HTTPS JSON&lt;br&gt;Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="OCR text lines&lt;br&gt;/import/parse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n4" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="305"/><mxPoint x="480" y="230"/></Array></mxGeometry></mxCell><mxCell id="n34" value="POST /mcp&lt;br&gt;mgo_ token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="720"/><mxPoint x="470" y="880"/><mxPoint x="1150" y="880"/><mxPoint x="1150" y="208"/></Array></mxGeometry></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="/agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="208"/><mxPoint x="500" y="480"/></Array></mxGeometry></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="n15" target="n24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="691" y="374"/><mxPoint x="1230" y="374"/><mxPoint x="1230" y="356"/></Array></mxGeometry></mxCell><mxCell id="n39" value="parameterised&lt;br&gt;SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="312"/><mxPoint x="1200" y="165"/></Array></mxGeometry></mxCell><mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="550"/><mxPoint x="1220" y="200"/></Array></mxGeometry></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n13" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="340"/><mxPoint x="1180" y="434"/></Array></mxGeometry></mxCell><mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n13" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="350"/><mxPoint x="1190" y="510"/></Array></mxGeometry></mxCell><mxCell id="n43" value="weekly report" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n19" target="n27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="692"/><mxPoint x="1200" y="586"/></Array></mxGeometry></mxCell><mxCell id="n44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n27" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="640"/><mxPoint x="1230" y="640"/><mxPoint x="1230" y="960"/><mxPoint x="240" y="960"/></Array></mxGeometry></mxCell><mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n47" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#82B366;" edge="1" parent="1" source="n30" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="980"/><mxPoint x="20" y="980"/><mxPoint x="20" y="200"/></Array></mxGeometry></mxCell><mxCell id="n48" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#82B366;" edge="1" parent="1" source="n31" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1565" y="990"/><mxPoint x="840" y="990"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
