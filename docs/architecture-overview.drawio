        <mxCell id="email" value="&lt;b style='font-size:15px'&gt;Email&lt;/b&gt; (Resend)&lt;br&gt;&lt;span style='font-size:12px'&gt;Verification · weekly report&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
