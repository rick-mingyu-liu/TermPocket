        "tools": { "include": ["propose_transactions"], "exclude": ["propose_goal"] },
        "maxToolCalls": 2,
        "draft": { "count": 1, "newRows": 1, "rows": [{ "type": "expense", "amount": "12.50", "currency": "CAD", "category": "Dining Out", "date": "2026-10-14" }] },
        "goalProposal": null,
        "reply": { "mustContainAny": [["confirm", "review"]] }
      }
    },
