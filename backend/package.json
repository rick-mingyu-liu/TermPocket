{
  "name": "personal-finance-backend",
  "version": "1.0.0",
  "description": "Backend API for Personal Finance Web App",
  "main": "dist/app.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepare": "npm run build",
    "start": "node dist/app.js",
    "dev": "tsx watch app.ts",
    "db:setup": "node dist/db/setup.js",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "access-token": "node dist/db/accessToken.js",
    "agent:eval": "node dist/scripts/agentEval.js",
    "agent:preflight": "node dist/scripts/agentPreflight.js",
    "lint": "eslint .",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "keywords": [
    "finance",
    "api",
    "express",
    "postgresql",
    "ai"
  ],
  "author": "Personal Finance App",
  "license": "SEE LICENSE IN ../LICENSE.md"
}
