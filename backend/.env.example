# TermPocket backend — environment variables
#
# Copy to .env and fill in. Every variable the backend reads is listed here;
# the authoritative source is config/index.ts, which is the only file allowed
# to touch process.env. If you add a variable, add it in both places.
#
# The server refuses to start without the REQUIRED ones (see config/validate.ts)
# and warns for missing email/address-validation credentials. Optional agent
# availability is reported by GET /agent/status; a missing key does not stop boot.


# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. This project uses Neon; the app should point at
# the *pooled* endpoint (hostname contains "-pooler"). Use the direct endpoint
# — same host without "-pooler" — for pg_dump and restores.
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Signing key for auth tokens. Use at least 32 random characters; the server
# warns below that. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string


# ─── Server ──────────────────────────────────────────────────────────────────

# Defaults to 3001. Render sets this itself, so leave it unset there.
PORT=3001

# "development" or "production". In production the database connection enables
# SSL and console logging is switched off.
NODE_ENV=development

# Origins allowed by CORS — the frontend's URL, or several separated by commas
# (e.g. https://www.termpocket.com,https://mind-go.vercel.app). Defaults to http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Base URL used to build links inside outgoing email (e.g. verification links).
# Defaults to http://localhost:3000. Must be the public frontend URL in production.
FRONTEND_URL=http://localhost:3000

# "error" | "warn" | "info" | "debug". Defaults to info.
LOG_LEVEL=info


# ─── Optional: email ─────────────────────────────────────────────────────────
# Without these no mail is sent. Registration requires a verified email before
# login, so on a fresh database nobody can complete signup without them.
# EMAIL_PASS is a Gmail app password, not the account password.

EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-character-app-password

# Optional: send through another SMTP server instead of Gmail. Unset = Gmail.
# Resend: EMAIL_HOST=smtp.resend.com, EMAIL_PORT=465, EMAIL_USER=resend,
# EMAIL_PASS=<Resend API key>. Port 465 uses implicit TLS, any other STARTTLS;
# an unset or invalid EMAIL_PORT means 465. EMAIL_FROM sets the From header
# (default: "TermPocket" <EMAIL_USER>), and the domain must be verified at the
# provider.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_FROM=TermPocket <noreply@termpocket.com>
# The "Questions?" address in every email's footer (default below).
# EMAIL_SUPPORT_ADDRESS=support@termpocket.com

# The Sunday 7 p.m. (Toronto) weekly report emails every opted-in user in the
# database this backend points at, so it runs only under NODE_ENV=production
# unless set here: "true" sends from any environment, "false" never sends.
# Leave it unset locally: the Neon dev branch holds copies of real addresses.
# WEEKLY_REPORT_ENABLED=


# ─── Optional: third-party APIs ──────────────────────────────────────────────

# Deliverability check on addresses at registration (rejects disposable
# domains and undeliverable mailboxes). Genuinely optional: without it —
# and whenever apilayer is unreachable, out of quota, or answering with a
# shape we do not recognise — services/emailValidationService.js falls back
# to its own 30-domain disposable list. Registration keeps working either
# way; the filtering is just weaker. It used to 500 instead (item 13).
MAILBOXLAYER_API_KEY=

# Optional conversation recording. Install migration 013 on PostgreSQL 15+
# (verify local/staging first) before enabling storage with AGENT_ENABLED=true.
# false: agent routes/maintenance do not query agent tables; history is retained.
# true with no key: history, draft edits/confirmation, undo and deletion work;
# new model turns remain unavailable. The key enables Claude model turns.
# Messages, relevant history, pending drafts and date/currency/timezone context
# go to Anthropic (the Claude API). Stored conversations can be accessed by authorized admins.
# Drafts become transactions only through explicit confirmation.
# Hosting needs outbound HTTPS to api.anthropic.com and request timeouts longer
# than 90 seconds plus cleanup.
# Keep the key private; no frontend NEXT_PUBLIC variable should contain it.
AGENT_ENABLED=false
# A Claude API key from console.anthropic.com (sk-ant-api...). Not a claude.ai
# subscription login. Only claude-haiku-5-5 works without a runtime change:
# the runtime turns thinking off, which Sonnet/Opus 5.5 reject.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Model turns running at once on this process (default 4); extra turns get
# agent_server_busy (429).
# AGENT_MAX_CONCURRENT_RUNS=4
# New model turns per rolling 24 hours: per account (default 60) and across all
# accounts (default 600). Over either, a new turn gets 429 agent_daily_limit or
# agent_daily_capacity. Set the all-accounts figure from what you will pay per
# day, and also set a spending limit in the Anthropic Console itself.
# AGENT_MAX_TURNS_PER_DAY=60
# AGENT_MAX_TURNS_PER_DAY_ALL_USERS=600


# ─── Optional: rate limiting ─────────────────────────────────────────────────
# All per-IP, over a 15-minute window. Defaults shown.
#
# RATE_LIMIT_API_MAX is worth watching: the dashboard fires roughly five
# requests per page load, so 100 is about twenty loads per quarter hour, and
# everyone behind one NAT shares the bucket.
#
# RATE_LIMIT_AUTH_MAX covers /register, /login, /resend-verification and
# /test-email *together* — five is five across all of them, not five each.

# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_AUTH_MAX=5

# RATE_LIMIT_IMPORT_MAX (default 30) is per *user*, not per IP: each
# screenshot parse queries that user's transactions and may call the LLM.
# RATE_LIMIT_IMPORT_MAX=30

# RATE_LIMIT_ACCOUNT_DELETE_MAX (default 5) is per *user*: DELETE /auth/account
# attempts, each of which checks the password.
# RATE_LIMIT_ACCOUNT_DELETE_MAX=5

# ─── Optional: screenshot import ─────────────────────────────────────────────
# Rows whose least certain field is below this are flagged "Check" (0–1].
# IMPORT_CONFIDENCE_THRESHOLD=0.8

# ─── Optional: database alternatives ─────────────────────────────────────────
# Only used when DATABASE_URL is unset — for a local Postgres without a
# connection string. Supply all of DB_USER, DB_HOST and DB_DATABASE together.

# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=mindgo

# Schema to pin search_path to; defaults to "public". Queries name tables
# unqualified, so this has to be the schema that holds them. See the comment
# in db/connection.js for why it is set per connection.
# DB_SCHEMA=public


# --- Demo account refresh (optional, off by default) --------------------------
# The demo account's data is generated relative to today, so it needs
# re-writing periodically or it goes stale again. Setting this to `true` makes
# the hourly maintenance run check when the demo account was last refreshed
# (the earliest created_at among its transactions; rows a visitor adds are
# created later, so they cannot postpone it) and rewrite the account when that
# is more than DEMO_REFRESH_STALE_DAYS days ago, or when it has no
# transactions. The check is one SELECT on the run that already queries.
#
# It DELETES every transaction and goal belonging to the demo
# account before rewriting them, which is why it is opt-in rather than
# opt-out. It identifies that account by the `is_demo` column (migration 007),
# never by an email address, and it will not create the account — run
# `npm run db:seed` once first. With nothing flagged it logs and does nothing.
#
# Anything a visitor adds while trying out the demo is discarded by the
# refresh. For a demo account that is usually the point; it does mean the demo
# cannot double as a scratch account.
DEMO_REFRESH_ENABLED=
# Days after the last refresh before the next one. Default 14; values below 7
# are raised to 7, since each refresh discards what visitors added.
# DEMO_REFRESH_STALE_DAYS=14
